{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@24.11.1",
    "poetry@latest",
    "postgresql@latest",
    "python@3.14",
    "zstd@latest",
    "mpdecimal@latest",
    "gdbm@latest",
    "xz@latest",
    "openssl@latest",
    "pkg-config@latest",
    "tcl@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      ". $VENV_DIR/bin/activate"
    ],
    "scripts": {
      "make-migrations": [
        "cd $DEVBOX_PROJECT_ROOT/backend",
        "python manage.py makemigrations"
      ],
      "migrate": [
        "cd $DEVBOX_PROJECT_ROOT/backend",
        "python manage.py migrate"
      ],
      "install-dependencies": [
        "cd $DEVBOX_PROJECT_ROOT/backend",
        "poetry install",
        "cd ..",
        "cd $DEVBOX_PROJECT_ROOT/frontend",
        "npm i"
      ]
    }
  }
}
